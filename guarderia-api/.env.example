ENV=dev
POSTGRES_USER=guarderia
POSTGRES_PASSWORD=123456
POSTGRES_DB=guarderia
# llave que firma los access tokens (HS256). OBLIGATORIA: sin ella la API no arranca.
# genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# duración de los tokens en segundos (access: 5 min, refresh: 7 días).
ACCESS_TTL_S=300
REFRESH_TTL_S=604800
# intentos fallidos de entrada: tantos por correo (o por IP) en la ventana y se bloquea hasta que pase.
AUTH_MAX_FAILURES=5
AUTH_MAX_FAILURES_IP=30
AUTH_WINDOW_S=900
# orígenes web (separados por coma) que pueden llamar a la API desde un navegador. Vacío = ninguno.
CORS_ORIGINS=
# contraseña que "python -m app.seed" les pone a las personas de ejemplo (solo con ENV=dev).
SEED_PASSWORD=codea1234

# fotos y documentos (S3 o compatible). La URL pública es la que ve el teléfono:
# emulador de Android: http://10.0.2.2:9000 (así lo ve el emulador).
# celular físico por USB con `adb reverse tcp:9000 tcp:9000`: http://localhost:9000.
S3_ACCESS_KEY=guarderia
S3_SECRET_KEY=cambia-esta-clave
S3_BUCKET=guarderia
S3_PUBLIC_ENDPOINT_URL=http://10.0.2.2:9000

# correo del primer administrador que crea "python -m app.seed".
SEED_ADMIN_EMAIL=admin@oruga.test

# enlace de invitación (opcional). PUBLIC_BASE_URL es la dirección https pública de la API, sin barra final:
# con ella el código de acceso trae un enlace que abre la app con el correo y el código puestos.
# ANDROID_CERT_SHA256 es la huella SHA-256 del certificado con que se firma la app (varias, separadas por coma),
# para que Android abra el enlace directo en la app. Vacíos = sin enlace; el admin solo comparte el código.
PUBLIC_BASE_URL=
ANDROID_CERT_SHA256=


# Aiven (opcional): descomenta y llena esta línea para usar Aiven en vez del Postgres local.
#     DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@HOST:PUERTO/codea_dev?ssl=require