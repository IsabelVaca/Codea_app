ENV=dev
POSTGRES_USER=guarderia
POSTGRES_PASSWORD=123456
POSTGRES_DB=guarderia
# dev = entrar con "Authorization: Bearer dev:<correo>" (solo con ENV=dev). firebase = tokens reales de Firebase Auth.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# ruta al JSON de la cuenta de servicio de Firebase (solo para cerrar sesiones al dar de baja).
FIREBASE_CREDENTIALS=

# fotos y documentos (S3 o compatible). La URL pública es la que ve el teléfono:
# emulador de Android: http://10.0.2.2:9000 (así lo ve el emulador).
# celular físico por USB con `adb reverse tcp:9000 tcp:9000`: http://localhost:9000.
S3_ACCESS_KEY=guarderia
S3_SECRET_KEY=cambia-esta-clave
S3_BUCKET=guarderia
S3_PUBLIC_ENDPOINT_URL=http://10.0.2.2:9000

# correo del primer administrador que crea "python -m app.seed".
SEED_ADMIN_EMAIL=admin@oruga.test


# Aiven (opcional): descomenta y llena esta línea para usar Aiven en vez del Postgres local.
#     DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@HOST:PUERTO/codea_dev?ssl=require