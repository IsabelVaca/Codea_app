# Producción en codeaapp.site (túnel de Cloudflare). Copia este archivo a .env.prod (no se versiona) y llena
# todo lo vacío. No reutilices ningún valor de desarrollo. Se usa con docker-compose.prod.yml (ver README.md).
ENV=prod

# Postgres local del servidor (servicio db). Contraseña larga y única.
POSTGRES_USER=guarderia
POSTGRES_PASSWORD=
POSTGRES_DB=guarderia
# o Aiven: descomenta y llena (la API usa esta en vez del Postgres local). Debe ser una base distinta de la de pruebas.
#     DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@HOST:PUERTO/codea_prod?ssl=require

# genera cada secreto con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TTL_S=300
REFRESH_TTL_S=604800
AUTH_MAX_FAILURES=5
AUTH_MAX_FAILURES_IP=30
AUTH_WINDOW_S=900
CORS_ORIGINS=

# almacén de fotos (SeaweedFS del compose). El teléfono lo ve por el túnel en archivos.codeaapp.site.
# fuera de ENV=dev la API no crea el bucket: créalo una vez después de levantar (README.md).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=guarderia
S3_PUBLIC_ENDPOINT_URL=https://archivos.codeaapp.site

# primer administrador (lo crea "python -m app.seed"; fuera de dev imprime su código de acceso, no una contraseña).
SEED_ADMIN_EMAIL=

# enlaces de invitación: https://api.codeaapp.site/invitar?... abre la app.
PUBLIC_BASE_URL=https://api.codeaapp.site
# huella SHA-256 del certificado con que se firma el APK de release (keytool -list -v -keystore ...).
ANDROID_CERT_SHA256=

# token del túnel: panel de Cloudflare -> Zero Trust -> Networks -> Tunnels -> tu túnel -> el valor después de --token.
CLOUDFLARE_TUNNEL_TOKEN=
