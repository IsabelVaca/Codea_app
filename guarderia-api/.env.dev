# Configuración de desarrollo para el equipo. NO trae ningún secreto real: todo aquí es solo para la máquina de
# cada developer y ya es público (el repo es público). Úsalo así:
#
#   cp .env.dev .env
#   docker compose up -d --build        # API en localhost:8000, Postgres y almacén de fotos locales
#   docker compose exec api alembic upgrade head
#   docker compose exec api python -m app.seed
#
# Sirve para trabajar en el backend y correr `pytest`. La app NO usa esta API: apunta siempre al servidor
# compartido (API_BASE_URL=https://api.codeaapp.site/api/v1/ en local.properties).
#
# Lo que NO va aquí, ni en ningún archivo del repo: la base de Aiven (DATABASE_URL), el token del túnel de
# Cloudflare, las llaves del almacén y la llave JWT de producción, y la contraseña de las cuentas del servidor
# compartido. Esos viven solo en .env.prod de la Mac que sirve codeaapp.site.
# Ninguno de estos valores se debe usar en producción.

ENV=dev

# Postgres local (servicio db del compose). La base se crea sola la primera vez.
POSTGRES_USER=guarderia
POSTGRES_PASSWORD=solo-desarrollo
POSTGRES_DB=guarderia

# llave que firma los access tokens. Esta es pública: solo sirve en tu máquina.
JWT_SECRET=solo-desarrollo-no-usar-en-produccion-codea-2026
ACCESS_TTL_S=300
REFRESH_TTL_S=604800

# límite de intentos fallidos de entrada.
AUTH_MAX_FAILURES=5
AUTH_MAX_FAILURES_IP=30
AUTH_WINDOW_S=900
CORS_ORIGINS=

# las cuentas de ejemplo de "python -m app.seed" entran con esta contraseña (solo con ENV=dev).
SEED_PASSWORD=codea1234
SEED_ADMIN_EMAIL=admin@oruga.test

# almacén de fotos local (SeaweedFS del compose).
S3_ACCESS_KEY=guarderia
S3_SECRET_KEY=solo-desarrollo
S3_BUCKET=guarderia
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# sin enlace de invitación en desarrollo: el código de acceso se comparte a mano.
PUBLIC_BASE_URL=
ANDROID_CERT_SHA256=
